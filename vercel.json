{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.dopraxis.app" }],
      "destination": "https://dopraxis.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://openclaw-nbqk.srv1571554.hstgr.cloud/praxis-api/api/$1" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
