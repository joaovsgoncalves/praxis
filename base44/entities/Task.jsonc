{
  "name": "Task",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time": {
      "type": "string"
    },
    "duration_minutes": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    },
    "priority": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "category": {
      "type": "string",
      "enum": [
        "work",
        "personal",
        "health",
        "learning",
        "finance",
        "other"
      ],
      "default": "personal"
    },
    "goal_id": {
      "type": "string"
    },
    "google_event_id": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "voice_ai"
      ],
      "default": "manual"
    },
    "focus_sessions_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title"
  ]
}