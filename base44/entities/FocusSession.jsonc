{
  "name": "FocusSession",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string"
    },
    "task_title": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "duration_seconds": {
      "type": "number"
    },
    "cycles_completed": {
      "type": "number",
      "default": 0
    },
    "focus_duration": {
      "type": "number",
      "default": 25
    },
    "break_duration": {
      "type": "number",
      "default": 5
    },
    "type": {
      "type": "string",
      "enum": [
        "task",
        "free"
      ],
      "default": "task"
    }
  },
  "required": []
}