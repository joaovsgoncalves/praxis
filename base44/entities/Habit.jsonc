{
  "name": "Habit",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "daily",
        "weekdays",
        "weekends",
        "weekly",
        "custom"
      ],
      "default": "daily"
    },
    "custom_days": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category": {
      "type": "string",
      "enum": [
        "health",
        "personal",
        "work",
        "learning",
        "finance",
        "other"
      ],
      "default": "personal"
    },
    "goal_id": {
      "type": "string"
    },
    "streak_target": {
      "type": "number",
      "default": 30
    },
    "current_streak": {
      "type": "number",
      "default": 0
    },
    "best_streak": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "archived"
      ],
      "default": "active"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "voice_ai"
      ],
      "default": "manual"
    }
  },
  "required": [
    "title"
  ]
}